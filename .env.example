# Legacy/bootstrap compatibility values. After opening the browser Settings tab,
# managed settings take precedence over these values (except explicitly injected
# environment variables, which remain deployment-level overrides).
# Keep this file for first startup, older deployments, and Compose interpolation.

# QQ 邮箱地址（机器人邮箱）
EMAIL_ADDRESS=your_bot@qq.com

# QQ 邮箱授权码（不是 QQ 密码！）
# 获取方式: QQ邮箱 → 设置 → 账户 → POP3/IMAP/SMTP服务 → 开启并获取授权码
EMAIL_PASSWORD=your_authorization_code

# Set to 0 while processing a test request if SMTP replies must be suppressed.
# The task and download lifecycle continues, but no SMTP outbox worker starts.
EMAIL_SEND_REPLIES=1

# Optional live E2E driver credentials; never used by the bot runtime.
# SENDER_ADDRESS=your_test_sender@qq.com
# SENDER_PASSWORD=your_test_sender_authorization_code

# 抖音 Cookie（首次启动可从这里提供；设置 Tab 保存后不在页面回显）
# 首次登录: uv run python get_cookie.py
# 之后可复用 Firefox 配置: uv run python get_cookie.py --headless
DOUYIN_COOKIE=your_douyin_cookie

# B站 Cookie（可选，仅登录/大会员/受限内容需要）
# 格式示例: BILIBILI_AUTH="SESSDATA=xxxxx; bili_jct=yyyyy"
BILIBILI_AUTH=

# Network-only web boundary settings. Use exact origins (no '*').
# Explicit trusted home-LAN address used by Docker Compose (not 0.0.0.0).
LAN_BIND_ADDRESS=192.168.1.94
# Settings PATCH is rejected with 403 unless FILE_BROWSER_ALLOWED_ORIGINS is set.
# Replace 192.168.1.94 if LAN_BIND_ADDRESS differs.
FILE_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://192.168.1.94:8081
WEB_LOGIN_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://192.168.1.94:8080
# Append the exact HTTPS origins exposed by Tailscale Serve (do not replace the
# local/LAN entries unless those paths are intentionally disabled):
# FILE_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:8081,http://localhost:8081,http://192.168.1.94:8081,https://your-machine.your-tailnet.ts.net
# WEB_LOGIN_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://192.168.1.94:8080,https://your-machine.your-tailnet.ts.net
# FILE_BROWSER_MAX_UPLOAD_BYTES=2147483648
# FILE_BROWSER_MAX_UPLOAD_FILES=10
# FILE_BROWSER_MEDIA_MAX_CONCURRENCY=2
# WEB_LOGIN_QR_RATE_LIMIT=5
# WEB_LOGIN_STATUS_RATE_LIMIT=120
# WEB_LOGIN_RATE_WINDOW_SECONDS=60

# Optional private CA bundle for strict HTTPS short-link resolution.
# DOUYIN_SHORT_LINK_CA_BUNDLE=/etc/ssl/private/douyin-ca.pem

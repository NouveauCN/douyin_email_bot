[Unit]
Description=Deferred Codex diagnosis worker for Douyin Email Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nouveau
WorkingDirectory=/home/nouveau/douyin_email_bot
Environment=CODEX_HOME=/home/nouveau/.codex
Environment=PATH=/home/nouveau/.local/bin:/usr/local/bin:/usr/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/nouveau/.local/bin/uv run --project /home/nouveau/douyin_email_bot python /home/nouveau/douyin_email_bot/codex_failure_worker.py --watch
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
